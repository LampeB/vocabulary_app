  {
    "rule": {
      "id": "particule-theme-eun-neun",
      "title_fr": "La particule de thème 은/는",
      "description_fr": "Marquer le thème de la phrase avec 은 après consonne finale et 는 après voyelle.",
      "explanation_fr": "En coréen, la particule 은/는 s'attache au mot dont on parle : le thème de la phrase. Elle correspond souvent à « quant à… » ou au sujet général en français. Le choix entre les deux formes est purement phonétique : si le mot se termine par une consonne finale (batchim), on ajoute 은 ; s'il se termine par une voyelle, on ajoute 는. Par exemple : 학생 + 은 → 학생은, mais 친구 + 는 → 친구는. Cette particule sert aussi à marquer un contraste entre deux éléments.",
      "prerequisite_lists": [
        "Salutations & politesse"
      ],
      "min_known_words": {
        "nom": 5
      },
      "applies_to_categories": [
        "nom",
        "lieu"
      ],
      "mechanics": {
        "type": "particle",
        "particle_forms": {
          "after_consonant": "은",
          "after_vowel": "는"
        }
      },
      "templates": [
        {
          "kind": "fill_blank",
          "prompt_fr_pattern": "Complétez avec 은 ou 는 : {nom}",
          "display_ko_pattern": "{nom}___",
          "answer_pattern": "{nom}{particle}"
        },
        {
          "kind": "transform",
          "prompt_fr_pattern": "Ajoutez la particule de thème au mot « {nom} ».",
          "display_ko_pattern": null,
          "answer_pattern": "{nom}{particle}"
        },
        {
          "kind": "fill_blank",
          "prompt_fr_pattern": "Complétez : « Quant à {nom}, il/elle est ici. »",
          "display_ko_pattern": "{nom}___ 여기 있어요.",
          "answer_pattern": "{nom}{particle}"
        },
        {
          "kind": "fill_blank",
          "prompt_fr_pattern": "Complétez : « Où est {nom} ? »",
          "display_ko_pattern": "{nom}___ 어디 있어요?",
          "answer_pattern": "{nom}{particle}"
        },
        {
          "kind": "transform",
          "prompt_fr_pattern": "Ajoutez la particule de thème au lieu « {lieu} ».",
          "display_ko_pattern": null,
          "answer_pattern": "{lieu}{particle}"
        }
      ],
      "worked_examples": [
        {
