            "먹다": "먹어요",
            "읽다": "읽어요",
            "듣다": "들어요",
            "걷다": "걸어요",
            "돕다": "도와요",
            "살다": "살아요",
            "바쁘다": "바빠요",
            "배고프다": "배고파요",
            "맛있다": "맛있어요",
            "맛없다": "맛없어요"
          }
        }
      },
      "templates": [
        {
          "kind": "transform",
          "prompt_fr_pattern": "Conjuguez « {verbe} » au présent poli (아요/어요).",
          "display_ko_pattern": null,
          "answer_pattern": "{verbe_present}"
        },
        {
          "kind": "fill_blank",
          "prompt_fr_pattern": "Complétez : « Maintenant, je {verbe}. »",
          "display_ko_pattern": "지금 ___.",
          "answer_pattern": "{verbe_present}"
