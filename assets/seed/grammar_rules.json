    "rule": {
      "id": "particules-sujet-objet-i-ga-eul-reul",
      "title_fr": "Les particules de sujet 이/가 et d'objet 을/를",
      "description_fr": "Marquer le sujet grammatical avec 이/가 et l'objet direct avec 을/를 selon la finale du mot.",
      "explanation_fr": "La particule 이/가 marque le sujet grammatical (qui fait l'action ou ce qui est décrit) ; la particule 을/를 marque l'objet direct (ce qui subit l'action). Le choix dépend uniquement du son final du mot : après une consonne finale (batchim), on utilise 이 pour le sujet et 을 pour l'objet ; après une voyelle, on utilise 가 et 를. Exemples : 물이 (sujet), 친구가 (sujet), 밥을 (objet), 우유를 (objet). Contrairement à 은/는 qui présente un thème, 이/가 met en avant une information nouvelle ou une réponse à « qui ? / quoi ? ».",
      "prerequisite_lists": [
        "Salutations & politesse",
        "La nourriture"
      ],
      "min_known_words": {
        "nom": 5,
        "verbe": 2
      },
      "applies_to_categories": [
        "nom",
        "lieu"
      ],
      "mechanics": {
        "type": "particle",
        "particle_forms": {
          "subject": {
            "after_consonant": "이",
            "after_vowel": "가"
          },
          "object": {
            "after_consonant": "을",
            "after_vowel": "를"
          }
        }
      },
      "templates": [
        {
          "kind": "transform",
          "prompt_fr_pattern": "Ajoutez la particule de sujet au mot « {nom} ».",
          "display_ko_pattern": null,
