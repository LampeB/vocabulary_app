  {
    "rule": {
      "id": "present-poli-ayo-eoyo",
      "title_fr": "Le présent poli en 아요/어요",
      "description_fr": "Conjuguer verbes et adjectifs au présent poli selon l'harmonie vocalique du radical.",
      "explanation_fr": "Pour conjuguer au présent poli, on retire 다 de la forme du dictionnaire pour obtenir le radical, puis on ajoute une terminaison selon l'harmonie vocalique : si la dernière voyelle du radical est ㅏ ou ㅗ, on ajoute 아요 ; sinon, on ajoute 어요 ; les verbes en 하다 deviennent 해요. Des contractions s'appliquent quand le radical finit par une voyelle : 가 + 아요 → 가요, 오 + 아요 → 와요, 보 + 아요 → 봐요, 마시 + 어요 → 마셔요. Certains verbes sont irréguliers : 듣다 → 들어요, 돕다 → 도와요, 바쁘다 → 바빠요.",
      "prerequisite_lists": [
        "Salutations & politesse",
        "La nourriture",
        "La vie quotidienne"
      ],
      "min_known_words": {
        "verbe": 5
      },
      "applies_to_categories": [
        "verbe",
        "adjectif"
      ],
      "mechanics": {
        "type": "conjugation",
        "conjugation": {
          "stem_derivation": "Retirer 다 de la forme du dictionnaire pour obtenir le radical, puis ajouter la terminaison ; appliquer les contractions vocaliques quand le radical se termine par une voyelle (아+아요→아요, 오+아요→와요, 이+어요→여요, 우+어요→워요, ㅡ tombe devant la terminaison).",
          "classes": [
            {
              "when": "la dernière voyelle du radical est ㅏ ou ㅗ",
              "ending": "아요"
            },
            {
              "when": "la dernière voyelle du radical n'est ni ㅏ ni ㅗ",
              "ending": "어요"
            },
            {
              "when": "le verbe se termine par 하다",
              "ending": "해요 (remplace 하다)"
            }
          ],
          "irregulars": {
            "하다": "해요",
            "공부하다": "공부해요",
            "일하다": "일해요",
            "좋아하다": "좋아해요",
            "도착하다": "도착해요",
            "출발하다": "출발해요",
