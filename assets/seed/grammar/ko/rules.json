    {
      "rule": {
        "id": "particules-lieu-e-eseo",
        "title": {
          "fr": "Les particules de lieu 에 et 에서",
          "en": "The place particles 에 and 에서"
        },
        "description": {
          "fr": "Distinguer 에 (destination, temps) et 에서 (lieu où se déroule une action).",
          "en": "Distinguish 에 (destination, time) from 에서 (place where an action happens)."
        },
        "explanation": {
          "fr": "La particule 에 marque la destination d'un déplacement (« à, vers ») avec des verbes comme 가다, 오다, 도착하다, ainsi que le moment (« à, le ») avec les mots de temps : 학교에 가요, 아침에 일어나요. La particule 에서 marque le lieu où une action se déroule (« à, dans ») avec les verbes d'action : 식당에서 밥을 먹어요, 회사에서 일해요. Ni 에 ni 에서 ne changent de forme selon la finale du mot : elles s'attachent telles quelles après consonne comme après voyelle. Astuce : déplacement vers → 에 ; activité sur place → 에서.",
          "en": "The particle 에 marks the destination of movement (\"to, toward\") with verbs like 가다, 오다, 도착하다, and also the moment (\"at, on\") with time words: 학교에 가요, 아침에 일어나요. The particle 에서 marks the place where an action takes place (\"at, in\") with action verbs: 식당에서 밥을 먹어요, 회사에서 일해요. Neither 에 nor 에서 changes form with the word ending: they attach as-is after a consonant or a vowel. Tip: movement toward → 에; activity on the spot → 에서."
        },
        "prerequisite_lists": [
          "starter-food",
          "starter-daily-life",
          "starter-getting-around"
        ],
        "min_known_words": {
          "lieu": 4,
          "verbe": 3
        },
        "applies_to_categories": [
          "lieu"
        ],
        "mechanics": {
          "type": "particle",
          "particle_forms": {
            "destination_or_time": {
              "after_consonant": "에",
              "after_vowel": "에"
            },
            "action_location": {
              "after_consonant": "에서",
              "after_vowel": "에서"
            }
          }
        },
        "worked_examples": [
          {
            "target": "저는 아침에 학교에 가요.",
            "translations": {
              "fr": "Le matin, je vais à l'école.",
              "en": "In the morning, I go to school."
            }
          },
          {
            "target": "식당에서 밥을 먹어요.",
            "translations": {
              "fr": "Je mange au restaurant.",
              "en": "I eat at the restaurant."
            }
          },
          {
            "target": "친구가 프랑스에서 와요.",
            "translations": {
              "fr": "Mon ami vient de France.",
              "en": "My friend comes from France."
            }
          }
        ],
        "test_vectors": [
