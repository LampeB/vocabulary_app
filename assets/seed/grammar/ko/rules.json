    {
      "rule": {
        "id": "negation-an",
        "title": {
          "fr": "La négation avec 안",
          "en": "Negation with 안"
        },
        "description": {
          "fr": "Former la négation en plaçant 안 juste avant le verbe ou l'adjectif conjugué.",
          "en": "Form the negative by placing 안 right before the conjugated verb or adjective."
        },
        "explanation": {
          "fr": "Pour nier une action ou un état, on place l'adverbe 안 immédiatement avant le verbe ou l'adjectif conjugué : 가요 → 안 가요, 먹어요 → 안 먹어요. Exception importante : pour les verbes composés « nom + 하다 » (공부하다, 일하다…), 안 s'insère entre le nom et 하다 : 공부해요 → 공부 안 해요, et non 안 공부해요. Le verbe 좋아하다 fait exception à l'exception : on dit 안 좋아해요. Pour 맛있다, la langue préfère l'adjectif contraire 맛없어요 plutôt que 안 맛있어요. 안 s'écrit séparé du verbe par une espace.",
          "en": "To negate an action or a state, place the adverb 안 immediately before the conjugated verb or adjective: 가요 → 안 가요, 먹어요 → 안 먹어요. Important exception: for \"noun + 하다\" compound verbs (공부하다, 일하다…), 안 goes between the noun and 하다: 공부해요 → 공부 안 해요, not 안 공부해요. The verb 좋아하다 is an exception to the exception: say 안 좋아해요. For 맛있다, the language prefers the opposite adjective 맛없어요 rather than 안 맛있어요. 안 is written separated from the verb by a space."
        },
        "prerequisite_lists": [
          "starter-food",
          "starter-daily-life"
        ],
        "min_known_words": {
          "verbe": 5
        },
        "applies_to_categories": [
          "verbe",
          "adjectif"
        ],
        "mechanics": {
          "type": "negation",
          "negation": {
            "pattern": "안 + forme conjuguée du verbe ou de l'adjectif, séparé par une espace",
            "hada_compounds": "Pour les verbes « nom + 하다 », insérer 안 entre le nom et 하다 : 공부하다 → 공부 안 해요 ; exception : 좋아하다 → 안 좋아해요",
            "irregulars": {
              "공부하다": "공부 안 해요",
              "일하다": "일 안 해요",
