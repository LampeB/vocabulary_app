platform :ios, '13.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  settings = File.join(__dir__, 'Flutter', 'Generated.xcconfig')
  unless File.exist?(settings)
    raise "#{settings} must exist. Run flutter pub get before pod install."
  end

  File.foreach(settings) do |line|
    root = line.match(/^FLUTTER_ROOT=(.*)$/)
    return root[1].strip if root
  end
  raise "FLUTTER_ROOT is missing from #{settings}. Run flutter pub get."
end

require File.join(flutter_root, 'packages', 'flutter_tools', 'bin', 'podhelper')

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  flutter_install_all_ios_pods __dir__

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # Build the aggregate framework and Runner for ML Kit's simulator slice.
    target.build_configurations.each do |configuration|
      configuration.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] =
        '$(inherited) i386 arm64'
    end
  end
end
